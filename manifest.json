{
  "manifest_version": 3,
  "name": "Link Extractor 9000",
  "version": "0.1.0",
  "description": "Collect URLs from pages and search results into a persistent, copyable list.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "link-extractor-9000@deon-trevor",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_title": "Link Extractor 9000",
    "default_popup": "src/popup/popup.html"
  }
}
